{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "utils/globals.d.ts",
    "utils/dom/mutation.js",
    "utils/dom/intersection.js",
    "utils/lifecycle.js",
    "utils/media/script-loader.js",
    "utils/network.js",
    "utils/storage.js",
    "utils/url.js"
  ]
}
